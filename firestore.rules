rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /referralCodes/{code} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /affiliateCodes/{code} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /affiliates/{affiliateId} {
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow write: if false;

      match /attributions/{inviteeUid} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/affiliates/$(affiliateId)).data.uid == request.auth.uid;
        allow write: if false;
      }
    }

    match /affiliateCommissions/{commissionId} {
      allow read: if request.auth != null
        && resource.data.affiliateId != null
        && get(/databases/$(database)/documents/affiliates/$(resource.data.affiliateId)).data.uid == request.auth.uid;
      allow write: if false;
    }

    match /affiliatePayouts/{payoutId} {
      allow read: if request.auth != null
        && resource.data.affiliateId != null
        && get(/databases/$(database)/documents/affiliates/$(resource.data.affiliateId)).data.uid == request.auth.uid;
      allow write: if false;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /referralInvites/{inviteId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      match /referralMeta/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      match /affiliateMeta/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      match /supportMessages/{messageId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      match /supportMeta/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      match /privateMeta/{docId} {
        allow read, write: if false;
      }

      match /faceScans/{scanId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /{firstSegment}/{document=**} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId
          && firstSegment != 'referralInvites'
          && firstSegment != 'referralMeta'
          && firstSegment != 'affiliateMeta'
          && firstSegment != 'supportMessages'
          && firstSegment != 'supportMeta'
          && firstSegment != 'privateMeta';
      }
    }

    match /crispSessions/{sessionId} {
      allow read, write: if false;
    }

    match /usernames/{tag} {
      function validUsernameDocument() {
        return request.resource.data.keys().hasOnly([
            'userId', 'displayName', 'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'userId', 'displayName', 'updatedAt'
          ])
          && request.resource.data.userId is string
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 80
          && request.resource.data.updatedAt == request.time
          && tag.size() >= 3
          && tag.size() <= 24;
      }

      // La recherche exacte d'un tag reste possible, mais l'énumération
      // complète de tous les utilisateurs est interdite.
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && !exists(/databases/$(database)/documents/usernames/$(tag))
        && validUsernameDocument();
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && validUsernameDocument();
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }
  }
}
