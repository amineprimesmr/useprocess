# Firebase (ne pas committer les clés)
**/GoogleService-Info.plist
**/BodyScanSecrets.plist
**/CoachSecrets.plist
**/RevenueCatSecrets.plist
**/PostHogSecrets.plist
**/CrispSecrets.plist
.secrets/
firebase/.referral-webhook-secret.local
firebase/.affiliate-admin-secret.local
firebase/functions/node_modules/
.DS_Store
**/.DS_Store

# Xcode
DerivedData/
.derivedData/
Index.noindex/
SourcePackages/
*.xcuserstate
xcuserdata/

# Lymph circuit demo videos — originals backed up under content/app-media/source/
# After running scripts/compress-app-bundle-assets.sh, bundled MP4s are ~1–3 MB each (HEVC 720p).
useprocess/Resources/LymphCircuit/**/*.mp4
useprocess/Resources/LymphCircuit/**/*.mov
!useprocess/Resources/LymphCircuit/.gitkeep

# Original full-size media backups (never commit)
content/app-media/source/**/*
!content/app-media/source/**/.gitkeep

# Onboarding transformation videos (recompress locally via scripts/compress-app-bundle-assets.sh)
useprocess/Resources/Onboarding/**/*.mp4

# Localization extract artifacts
scripts/_extracted_copy.json
scripts/copy_chunks/

# TikTok content assets (keep folder structure, ignore media)
content/tiktok/raw/**/*.{jpg,jpeg,png,webp,heic,mov,mp4}
content/tiktok/branded/**/*.{jpg,jpeg,png,webp,heic,mov,mp4}
content/tiktok/exemples/**/*
content/tiktok/generated/**/*
content/tiktok/queue/**/*
content/tiktok/posted/**/*
!content/tiktok/**/.gitkeep
!content/tiktok/**/*.md
!content/tiktok/**/*.example.json
