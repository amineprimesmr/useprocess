{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/join/:code",
      "destination": "/?ref=:code",
      "permanent": false
    },
    {
      "source": "/get",
      "destination": "/?get=1",
      "permanent": false
    },
    {
      "source": "/telecharger",
      "destination": "/?get=1",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/join/(.*)", "destination": "/index.html" },
    { "source": "/studio", "destination": "/studio.html" },
    { "source": "/studio/", "destination": "/studio.html" },
    { "source": "/tiktok/callback", "destination": "/tiktok/callback/index.html" },
    { "source": "/(.*)", "destination": "/index.html", "has": [{ "type": "host", "value": "join.useprocess.xyz" }] }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
