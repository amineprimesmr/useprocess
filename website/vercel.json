{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/terms",
      "destination": "/cgu?lang=en",
      "permanent": false
    },
    {
      "source": "/privacy",
      "destination": "/confidentialite?lang=en",
      "permanent": false
    },
    {
      "source": "/legal-notice",
      "destination": "/mentions-legales?lang=en",
      "permanent": false
    },
    {
      "source": "/health-sources",
      "destination": "/sources-sante?lang=en",
      "permanent": false
    },
    {
      "source": "/join/:code",
      "destination": "/?ref=:code",
      "permanent": false
    },
    {
      "source": "/c/:slug",
      "destination": "/app?utm_source=:slug&utm_medium=campaign&utm_campaign=:slug",
      "permanent": false
    },
    {
      "source": "/i",
      "destination": "/app",
      "permanent": true
    },
    {
      "source": "/a",
      "destination": "/app",
      "permanent": true
    },
    {
      "source": "/get",
      "destination": "/app",
      "permanent": true
    },
    {
      "source": "/telecharger",
      "destination": "/app",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "get.useprocess.xyz" }],
      "destination": "https://useprocess.xyz/app",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/app", "destination": "/app.html" },
    { "source": "/join/(.*)", "destination": "/index.html" },
    { "source": "/studio", "destination": "/studio.html" },
    { "source": "/studio/", "destination": "/studio.html" },
    { "source": "/affiliate", "destination": "/affiliate.html" },
    { "source": "/affiliate/", "destination": "/affiliate.html" },
    { "source": "/tiktok/callback", "destination": "/tiktok/callback/index.html" },
    { "source": "/(.*)", "destination": "/index.html", "has": [{ "type": "host", "value": "join.useprocess.xyz" }] },
    { "source": "/((?!api|assets|cgu|confidentialite|mentions-legales|support|sources-sante|tiktok|\\.well-known).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
